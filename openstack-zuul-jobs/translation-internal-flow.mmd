sequenceDiagram
    autonumber
    participant Job as Job Executor (Ansible)
    participant Up as upstream_translation_update.sh
    participant Pr as propose_translation_update.sh
    participant Lib as common_translation_update.sh
    participant API as External (Zanata/Gerrit)

    %% ============================================================
    %% 1번(Check) & 4번(Promote) 파이프라인 매핑
    %% ============================================================
    Note over Job, API: [Pipeline 1(Check) & 4(Promote)] Execute 'upstream' Script

    Job->>Up: Execute upstream_translation_update.sh
    Up->>Lib: source common_translation_update.sh
    Lib-->>Up: Load functions & env variables
    
    %% 초기화
    Up->>Lib: Call setup_logging()
    Up->>Lib: Call check_params() (Validate API Key, Project name)
    
    Up->>Lib: Call extract_messages()
    Note right of Lib: [Common] Generate .pot (pybabel extract)

    %% Check는 멈추고, Promote는 보냄
    alt If Pipeline == 1. CHECK
        Note right of Up: 🛑 STOP here (Dry-run Mode)
        Note right of Up: Verify extraction success & Exit
    else If Pipeline == 4. PROMOTE
        Note right of Up: 🚀 PROCEED (Real-run Mode)
        Up->>Lib: Call upload_pot_to_zanata()
        Lib->>API: zanata-cli push (HTTP API)
        Note left of API: Register English Source (msgid)
    end

    %% ============================================================
    %% 5번(Periodic) 파이프라인 매핑
    %% ============================================================
    Note over Job, API: [Pipeline 5(Periodic)] Execute 'propose' Script

    Job->>Pr: Execute propose_translation_update.sh
    Pr->>Lib: source common_translation_update.sh
    Lib-->>Pr: Load functions & env variables

    %% 초기화 (Propose 단계도 동일하게 수행)
    Pr->>Lib: Call setup_logging()
    Pr->>Lib: Call check_params()
    
    %% 1. 다운로드
    Pr->>Lib: Call download_po_from_zanata()
    Lib->>API: zanata-cli pull (HTTP API)
    Note left of API: Download Translations (.po)
    
    %% 2. 압축 (최적화)
    Pr->>Lib: Call compress_po_files()
    Note right of Lib: Optimize .po files (Remove lines, Compressing)

    %% 3. 필터링 (변경사항 검증)
    Pr->>Lib: Call filter_commits()
    Note right of Lib: Check if changes are valid (Ignore timestamp only changes)

    %% 4. 제출 (조건부 실행 - send_patch)
    alt No Valid Changes
        Note right of Pr: 🚫 Skip Commit (Nothing to update)
    else Has Valid Changes
        Pr->>Lib: Call send_patch()
        Lib->>API: git review (Topic: zanata/translations)
        Note left of API: Submit Patch to Gerrit
    end

    %% ============================================================
    %% 공통 종료 처리
    %% ============================================================
    Note over Job, API: 🧹 [All Pipelines] Cleanup Phase
    Job->>Lib: Call finish()
    Note right of Lib: Remove temp dirs & Logs
