sequenceDiagram
    autonumber
    actor Dev as Developer
    participant Gerrit as Gerrit Code Review
    participant Zuul as Zuul System
    participant Nodes as Nodes (Infra)
    participant Job as Job Executor
    participant Secret as Secrets Store (Internal)
    participant Artifact as Artifact Store (Zuul)
    participant Zanata as Zanata Site

    %% ==========================================
    %% 1. CHECK PIPELINE (Verification: msgid Extraction Test)
    %% ==========================================
    rect rgb(235, 245, 251)
        Note right of Dev: 1. CHECK Pipeline (On PR Creation)
        
        Dev->>Gerrit: git push (Add new English msgid)
        Gerrit->>Zuul: Event: Patchset Created
        
        rect rgb(224, 247, 250)
            Note right of Zuul: Dynamic Config Sync
            Note right of Zuul: Reads temporary 'zuul.d/project.yaml'
        end

        par Resource & Config Eval
            Zuul->>Nodes: Request Node (ubuntu/centos) Based on nodesets.yaml
            Nodes-->>Zuul: Assign Fresh Node
        and Job Selection Logic
            Note right of Zuul: Filter jobs (Match: playbooks/translation)
        end

        %% Linters
        Zuul->>Job: [Trigger] openstack-zuul-jobs-linters
        Job->>Job: Exec: tox -e linters

        %% Translation
        Zuul->>Job: [Trigger] upstream-translation-update
        Note right of Job: Script: common_translation_update.sh<br/>Mode: Dry-run (ERROR_ABORT=1)
        
        %% POST-RUN (청소 및 로그 수집)
        rect rgb(238, 238, 238)
            Note right of Zuul: 🧹 Automatic Post-Run
            Job->>Artifact:Upload Stats ($JOBNAME.subunit.gz) & Logs
            Zuul->>Nodes: Delete/Return Nodes (Cleanup)
            Note right of Zuul: Resources released regardless of Success/Fail
        end

        alt ❌ Check Failed (Verified -1)
            Job--xZuul: Extraction Failed
            Zuul->>Gerrit: Vote: Verified -1
            Note right of Dev: Action: Check Logs for Babel/Lint errors
        else ✅ Check Passed (Verified +1)
            Job-->>Zuul: Extraction Succeeded
            Zuul->>Gerrit: Vote: Verified +1
            Note right of Dev: Action: Wait for Review
        end
    end

    %% ==========================================
    %% 2 & 3. HUMAN REVIEW & GATE PIPELINE (중략)
    %% ==========================================
    rect rgb(240, 240, 240)
        Note over Dev, Artifact: [중략] 2. HUMAN REVIEW: Core Reviewer +2 승인 ➔ 3. GATE PIPELINE: 병합 전 최종 빌드 테스트 ➔ Master Merge 완료
    end

    %% ==========================================
    %% 4. PROMOTE PIPELINE (Actual Sync & Proposal)
    %% ==========================================
    rect rgb(253, 235, 208)
        Note right of Dev: 4. PROMOTE Pipeline (Post-Merge)

        Gerrit->>Zuul: Event: Ref-Updated (Merged)
        
        %% Zuul 동기화 로직
        rect rgb(224, 247, 250)
            Note right of Zuul: Zuul Configuration Sync
            Zuul->>Zuul: Re-reads 'zuul.d/project.yaml'
            Note right of Zuul: Updates Scheduler with new job definitions
        end

        par Promote Actions
            %% Export: Exporting to Zanata
            opt Export: upstream_translation_update.sh
                Zuul->>Job: [Trigger] upstream-translation-update
                Job->>Secret: Fetch 'zanata_api_credentials'
                %% Script Execution Reference
                Job->>Job: Exec: common_translation_update.sh (Extract)
                
                rect rgb(232, 245, 233)
                    Note right of Job: 🌐 External API Call: PUSH
                    Job->>Zanata: push .pot (zanata-cli push)
                end
                Note right of Zanata: English Source Registered
            end

            %% Import: Proposing Translations
            opt Import: propose_translation_update.sh
                Zuul->>Job: [Trigger] propose-translation-update
                
                rect rgb(232, 245, 233)
                    Note right of Job: 🌐 External API Call: PULL
                    Job->>Zanata: pull .po (zanata-cli pull)
                end
                
                %% Script Execution Reference
                Job->>Job: Exec: common_translation_update.sh (Compress & Commit)
                Job->>Gerrit: git review (Topic: zanata/translations)
                Note right of Gerrit: Automated Translation Review Created
            end
            
            %% Docs Promote (병렬 실행)
            opt Docs Promote
                Zuul->>Job: [Trigger] publish-tox-docs-infra
                Job->>Job: Build & Publish Sphinx Docs
            end
        end
    end

    %% ==========================================
    %% 5. PERIODIC SYNC PIPELINE (Daily Early Morning)
    %% ==========================================
    rect rgb(255, 253, 231)
        Note right of Zuul: 5. PERIODIC Pipeline (Scheduled Sync)
        
        Zuul->>Zuul: Triggered by Timer (Daily 04:00 AM)
        
        rect rgb(224, 247, 250)
            Note right of Zuul: Zuul Config Check (Current Master)
        end
        
        Zuul->>Job: [Trigger] propose-translation-update
        Job->>Secret: Fetch 'zanata_api_credentials'
        
        rect rgb(232, 245, 233)
            Note right of Job: 🌐 External API Call: PULL
            Job->>Zanata: pull .po (zanata-cli pull)
        end
        
        %% Script Execution Reference
        Job->>Job: Exec: common_translation_update.sh (Process)
        Job->>Gerrit: git review (Topic: zanata/translations)
        Note right of Gerrit: Daily Translation Proposal Created

        %% POST-RUN (청소)
        rect rgb(238, 238, 238)
            Note right of Zuul: 🧹 Automatic Post-Run (Cleanup)
            Job->>Artifact:Upload Stats ($JOBNAME.subunit.gz) & Logs
            Zuul->>Nodes: Delete/Return Nodes
        end
    end
    
    Zuul-->>Dev: Translation Data Sync & Proposal Complete
